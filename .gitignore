# Byte-compiled / optimized / ambient files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
env/
venv/
ENV/

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Data governance (Keep raw and processed loan data out of git)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/README.md

# Large raw benchmark results (keep summaries and tables in git)
results/raw/*.jsonl
results/raw/*.csv
!results/raw/.gitkeep

# IDE / OS
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Temporary LaTeX build files
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
